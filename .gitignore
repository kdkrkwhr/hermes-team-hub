# OS / editor
.DS_Store
Thumbs.db
*.swp
*~

# Node (정적 사이트라 불필요)
node_modules/

# Local env / secrets
.env
.env.*
!.env.example

# Build output (미사용이나 혹시 모를 보험)
dist/
build/

# Python caches
**/__pycache__/
*.pyc

# team_hub local runtime data (운영 기록, 민감정보 포함)
local/team_hub/data/

# Logs
*.log

# Screenshot / audit scripts (working-tree only, never commit)
_audit*.js
shot_*.png

# 로컬 입력 데이터 (봇 메뉴용)
local/data/
